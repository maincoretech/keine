scene audio_loop {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  bgm(music, volume: 0.03),
  se.loop(ambience, click, volume: 0.03),
  stage.animate(bench_audio_loop, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene audio_crossfade {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  stage.animate(bench_audio_crossfade, duration: 8s, infinite: true, blocking: false) {
    event.audio(theme, bgm, music, time: 0ms, volume: 0.03, loop: true, fade_in: 1s),
    event.audio(theme, bgm, music_alt, time: 2s, volume: 0.03, loop: true, fade_in: 1s),
    event.audio(theme, bgm, music, time: 4s, volume: 0.03, loop: true, fade_in: 1s),
    event.audio(theme, bgm, music_alt, time: 6s, volume: 0.03, loop: true, fade_in: 1s),
    event.audio(voice, vocal, voice, time: 4s, volume: 0.03),
    event.audio(click, effect, click, time: 6s, volume: 0.03)
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene video_fullscreen {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  video.play(movie, movie, loop: true, muted: false, wait: false, mode: fullscreen),
  stage.animate(bench_video_fullscreen, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene video_mixed {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  video.play(movie, movie, loop: true, muted: true, alpha: 0.6, wait: false, mode: mixed),
  stage.animate(bench_video_mixed, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}
