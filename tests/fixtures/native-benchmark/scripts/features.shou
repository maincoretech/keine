scene transforms {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  stage.animate(bench_shared_transform_clock, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0), key(time: 4s, value: 30), key(time: 8s, value: 0) },
    track(character(hero), y) { key(time: 0ms, value: 0), key(time: 4s, value: 30), key(time: 8s, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene classic {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  camera.effect(all, bloom_intensity: 0.15, vignette_intensity: 0.25, color_saturation: 0.9),
  stage.animate(bench_classic_camera_properties, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

