scene events {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  stage.animate(bench_all_event_types, duration: 8s, infinite: true, blocking: false) {
    event.camera.shake(time: 1s, amplitude: 6, frequency: 10, duration: 1s),
    event.camera.patch(time: 2s, targets: all, bloom_intensity: 0.15),
    event.particle(snow, LIGHT_SNOW, time: 3s, duration: 2s, count: 80),
    event.audio(click, effect, click, time: 4s, volume: 0.05),
    event.scene(event_scene, time: 6s, transition: crossfade(500ms), fit: cover) { layer(room, night, distance: 4) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene playback {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  sprite.sequence(hero, fps: 8, loop: true) { frame(portrait), frame(portrait_alt) },
  stage.animate(bench_playback_options, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}
