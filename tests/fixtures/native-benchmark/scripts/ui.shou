scene text_layers {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  text.float("日期 · 场景字幕", x: 960, y: 200, hold: 60s, blocking: false),
  text.float("Runtime text layering", x: 960, y: 320, hold: 60s, blocking: false),
  stage.animate(bench_text_layers, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene curtain {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  screen.curtain.show(color: rgba(0, 0, 0, 0.4), duration: 0ms),
  stage.animate(bench_curtain, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene sprite_filter {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  sprite.transform(hero, blur: 3, brightness: 0.1, contrast: 0.1, saturation: 0.7),
  stage.animate(bench_sprite_filter, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene light_off {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  sprite.transform(hero, light: false),
  sprite.transform(friend, light: false),
  stage.animate(bench_light_off, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene choice {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  stage.animate(bench_choice, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  choice {
    "分支 1 · Continue": {},
