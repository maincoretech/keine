scene dialogue {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  stage.animate(bench_representative_dialogue, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  playback.auto(true),
  loop {
    hero: "少女：这是包含中文、Latin text 和标点的正常长度对白，持续打字与自动翻页。", auto: true,
    friend: "同伴：第二句触发角色焦点变化，测试 UI 更新与动态文字排版。", auto: true
  }
}

scene motion {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  stage.animate(bench_representative_portrait_motion, duration: 8s, infinite: true, blocking: false) {
    track(character(hero), x) { key(time: 0ms, value: -120), key(time: 4s, value: 120), key(time: 8s, value: -120) },
    track(character(friend), scale_x) { key(time: 0ms, value: 1), key(time: 4s, value: 1.1), key(time: 8s, value: 1) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene transition {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  stage.animate(bench_representative_scene_transition, duration: 8s, infinite: true, blocking: false) {
    event.scene(day_scene, time: 0ms, transition: crossfade(600ms), fit: cover) { layer(room, day, distance: 4) },
    event.scene(night_scene, time: 2s, transition: crossfade(600ms), fit: cover) { layer(room, night, distance: 4) },
    event.scene(day_scene, time: 4s, transition: crossfade(600ms), fit: cover) { layer(room, day, distance: 4) },
    event.scene(night_scene, time: 6s, transition: crossfade(600ms), fit: cover) { layer(room, night, distance: 4) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}
