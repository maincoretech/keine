scene stress {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  particle.show(snow, LIGHT_SNOW, count: 256),
  particle.show(rain, HEAVY_RAIN, count: 256),
  camera.effect(all, bloom_intensity: 0.2, godray_intensity: 0.2, fog_intensity: 0.15, blur_amount: 2),
  bgm(music, volume: 0.03),
  video.play(movie, movie, loop: true, muted: true, alpha: 0.2, wait: false, mode: mixed),
  stage.animate(bench_stress_composition, duration: 8s, infinite: true, blocking: false) {
    track(character(hero), x) { key(time: 0ms, value: -120), key(time: 4s, value: 120), key(time: 8s, value: -120) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}
