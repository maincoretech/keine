scene sampling {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  camera.effect(all, focal_distance: 3, blur_strength: 0.2, shock_intensity: 0.2),
  stage.animate(bench_classic_sampling, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene godray {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  camera.effect(all, godray_intensity: 0.25),
  stage.animate(bench_classic_godray, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene film_noise {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  camera.effect(all, film_grain_intensity: 0.2, old_film_intensity: 0.2),
  stage.animate(bench_classic_film_noise, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}

scene color_lens {
  background(day),
  sprite(hero, portrait, position: left(x: 240), layout: viewport(height: 0.85)),
  sprite(friend, portrait_alt, position: right(x: -240), layout: viewport(height: 0.85)),
  camera.effect(all, color_temperature: 0.1, color_exposure: 0.1, lens_flare_intensity: 0.2),
  stage.animate(bench_classic_color_and_lens, duration: 8s, infinite: true, blocking: false) {
    track(camera, x) { key(time: 0ms, value: 0) }
  },
  hero: "Runtime workload · 实际舞台与对白渲染"
}
