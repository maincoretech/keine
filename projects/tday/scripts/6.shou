  ),
  speaker_0001: "你怎么在……",
  speaker_0002: "来找你",
  text.retract(source: "来找你", keep: ""),
  // 演出：马上把直白的话收回一点；保持原站位。
  sprite.keyframes(object_0001, blocking: false) {
    frame(
      duration: 230ms,
