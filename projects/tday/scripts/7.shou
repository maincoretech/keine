    blend: alpha,
    scale: 1.32
  ),
  camera.bind(object_0001, distance: 1),
  "她看了我一眼",
  speaker_0002: "有时候啊",
  "她拢了拢有点卷起来的侧发放到耳朵后面",
  speaker_0002: "我会觉得你还是和以前一样嘛",
  "总感觉今天的相处没有学校那么严肃，但是也没有小时候那么亲密",
  "我到底追求的是什么",
  speaker_0001: "是啊——",
  "其实是有变化的吧",
  "她坐在餐桌对面，我准备去把厨房的窗也关了",
  text.box(visible: false, auto: true),
