    layout: viewport(height: 0.8),
    transition: fade(320ms),
    z: 100,
    blend: alpha,
    scale: 1.32
  ),
  speaker_0001: "我说，那个约定你还记得吗",
  "我盯着她",
  "她抿了抿嘴，轻轻地说",
  speaker_0002: "初中的那个约定吗",
  speaker_0002: "你还真是一个念旧的人啊",
  "我的鼻尖几乎可以碰到她的嘴唇了",
  speaker_0001: "跟念旧没关系吧",
  "只是所有你的事情我都几乎忘不掉",
  speaker_0002: "那天晚上我不是提前回答了你了嘛",
  "她绕着我的头发",
  speaker_0002: "如果你想的话……",
  // 演出：承诺说出口时只柔化背景，保持两人的立绘清晰。
  sprite.keyframes(scene_layer_0045, blocking: false) {
    frame(duration: 650ms, easing: ease_in_out, blur: 1.5)
  },
  // 演出：清楚而稳定地给出承诺；保持原站位。
  sprite.keyframes(object_0001, blocking: false) {
    frame(duration: 320ms, easing: ease_in_out, rotation: 0, scale_x: 1.32528, scale_y: 1.32792),
    frame(duration: 380ms, easing: ease_in_out, rotation: 0, scale_x: 1.32, scale_y: 1.32)
  },
  speaker_0002: "我喜欢你，我以后也会喜欢你",
  // 演出：承诺读完后恢复背景。
  sprite.keyframes(scene_layer_0045, blocking: false) {
    frame(duration: 800ms, easing: ease_in_out, blur: 0)
  },
  "忍着不让鼻息触碰她",
  speaker_0002: "该订新的约定了吧",
  "我摇摇头，也不是所有的事情都能一下子就解决的",
  // 演出：带着余裕回应以后；保持原站位。
  sprite.keyframes(object_0002, blocking: false) {
    frame(duration: 220ms, easing: ease_in_out, rotation: -0.005, scale_x: 1.32, scale_y: 1.32528),
